Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Line Style: Lines
      Color: 160; 160; 160
    - Class: rviz_default_plugins/PointCloud2
      Name: Map Scan
      Topic: /map_scan
      Enabled: true
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Decay Time: 0
    - Class: voxelslam_pointcloud2/VoxelSLAMPointCloud2
      Name: Current Map
      Topic:
        Value: /map_cmap
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Enabled: true
      Style: Points
      Size (Pixels): 1
      Size (m): 0.01
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 170; 190; 205
      Decay Time: 300
      Selectable: false
    - Class: voxelslam_pointcloud2/VoxelSLAMPointCloud2
      Name: Previous Map
      Topic:
        Value: /map_pmap
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Enabled: true
      Style: Points
      Size (Pixels): 1
      Size (m): 0.01
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 130; 155; 175
      Decay Time: 1000000
      Selectable: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Map Path
      Topic: /map_path
      Enabled: true
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 255; 0
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: camera_init
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200
