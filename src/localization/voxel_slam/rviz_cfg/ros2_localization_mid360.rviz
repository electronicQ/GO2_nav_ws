Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 5
      Line Style: Lines
      Color: 100; 100; 100
    - Class: rviz_default_plugins/PointCloud2
      Name: Historical Map
      Topic:
        Value: /localization/map_cloud
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Enabled: true
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 150; 170; 185
      Decay Time: 0
      Position Transformer: XYZ
      Alpha: 0.65
    - Class: rviz_default_plugins/PointCloud2
      Name: Current Scan
      Topic:
        Value: /map_scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Enabled: true
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 90; 45
      Decay Time: 0
      Position Transformer: XYZ
    - Class: rviz_default_plugins/PointCloud2
      Name: Current Path
      Topic:
        Value: /map_path
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Enabled: true
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Position Transformer: XYZ
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 300
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.8
      Yaw: 0.8
  Enabled: true
Window Geometry:
  Height: 800
  Width: 1200
