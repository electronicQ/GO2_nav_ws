<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_nav_bringup</name>
  <version>0.1.0</version>
  <description>Integrated live/bag bringup for GO2, external RS16/IMU, Voxel-SLAM and Nav2.</description>
  <maintainer email="robot@todo.todo">robot</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>go2_navigation2</exec_depend>
  <exec_depend>go2_twist_bridge</exec_depend>
  <exec_depend>voxel_slam</exec_depend>
  <exec_depend>voxel_map_tools</exec_depend>
  <exec_depend>rslidar_sdk</exec_depend>
  <exec_depend>wit_ros2_imu</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
